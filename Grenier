<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Floods</title>

<style>
* {
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 20px;
    background: #e8d2a8;
    color: #3b2818;
}

.conteneur {
    max-width: 850px;
    margin: auto;
}

h1 {
    text-align: center;
    font-size: 27px;
    margin: 0 0 20px 0;
    color: #5a321c;
    font-weight: bold;
}

.tableau {
    width: 100%;
    border: 2px solid #9b7046;
    background: #f3dfb9;
    border-radius: 3px;
    overflow: hidden;
}

.entete,
.ligne {
    display: grid;
    grid-template-columns: 1fr 150px 120px 55px;
    align-items: center;
}

.entete {
    min-height: 42px;
    background: #d8b986;
    border-bottom: 1px solid #9b7046;
    font-weight: bold;
    color: #5a321c;
}

.entete div,
.ligne > div {
    padding: 7px 10px;
}

.entete div:not(:last-child),
.ligne > div:not(:last-child) {
    border-right: 1px solid #c6a77b;
}

.ligne {
    min-height: 54px;
    border-bottom: 1px solid #c6a77b;
}

.ligne:last-child {
    border-bottom: none;
}

.ligne:nth-child(even) {
    background: #ead2a7;
}

.ligne:nth-child(odd) {
    background: #f4e2c1;
}

.ligne input {
    width: 100%;
    height: 36px;
    text-align: center;
    font-size: 15px;
    border: 1px solid #b99a6c;
    border-radius: 4px;
    background: #fffaf0;
    color: #3b2818;
}

.supprimer {
    width: 32px;
    height: 32px;
    display: block;
    margin: auto;
    border: 1px solid #9b7046;
    border-radius: 4px;
    background: #ead2a7;
    color: #5a321c;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
}

.supprimer:hover {
    background: #d8b986;
}

.plus {
    width: 100%;
    height: 42px;
    margin-top: 10px;
    border: 1px solid #315d32;
    border-radius: 4px;
    background: #4f8a52;
    color: white;
    font-size: 23px;
    font-weight: bold;
    cursor: pointer;
}

.plus:hover,
.bouton:hover {
    background: #417544;
}

.options {
    margin-top: 20px;
}

.bloc-calcul {
    display: flex;
    align-items: flex-end;
    gap: 15px;
}

.champ-pourcentage {
    flex: 1;
}

.label {
    display: block;
    font-size: 16px;
    font-weight: bold;
    margin-bottom: 7px;
    color: #5a321c;
}

.pourcentage {
    width: 100%;
    height: 45px;
    padding: 0 10px;
    font-size: 17px;
    text-align: center;
    border: 1px solid #b99a6c;
    border-radius: 4px;
    background: #fffaf0;
    color: #3b2818;
}

.bouton {
    width: 190px;
    height: 45px;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
    border: 1px solid #315d32;
    border-radius: 4px;
    background: #4f8a52;
    color: white;
}

.choix-calcul {
    margin-top: 15px;
    font-size: 16px;
    font-weight: bold;
    color: #5a321c;
}

.choix-calcul label {
    cursor: pointer;
}

.choix-calcul input {
    width: 17px;
    height: 17px;
    vertical-align: middle;
    margin-right: 7px;
}

#champDateCalcul {
    display: none;
    margin-top: 10px;
}

#dateCalcul {
    width: 100%;
    height: 42px;
    font-size: 16px;
    text-align: center;
    border: 1px solid #b99a6c;
    border-radius: 4px;
    background: #fffaf0;
    color: #3b2818;
}

.repartition {
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid #c6a77b;
}

.repartition-titre {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 10px;
    color: #5a321c;
}

.repartition-lignes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}

.repartition-case {
    text-align: center;
}

.repartition-case .label {
    font-size: 14px;
    margin-bottom: 5px;
}

.repartition-case input {
    width: 100%;
    height: 40px;
    text-align: center;
    font-size: 16px;
    border: 1px solid #b99a6c;
    border-radius: 4px;
    background: #fffaf0;
    color: #3b2818;
}

.somme {
    margin-top: 8px;
    font-size: 14px;
    font-weight: bold;
    color: #5a321c;
}

#resultat {
    margin-top: 20px;
    font-size: 19px;
    line-height: 1.6;
    font-weight: bold;
    color: #5a321c;
}

.message {
    margin-top: 10px;
    font-size: 14px;
    color: #6b4425;
}

@media (max-width: 650px) {

    body {
        padding: 12px;
    }

    .entete,
    .ligne {
        grid-template-columns: 1fr 85px 88px 43px;
    }

    .entete div,
    .ligne > div {
        padding: 6px 4px;
    }

    .entete {
        font-size: 13px;
    }

    .ligne input {
        font-size: 13px;
    }

    .bloc-calcul {
        gap: 10px;
    }

    .bouton {
        width: 145px;
        font-size: 15px;
    }

    .label {
        font-size: 14px;
    }

    .repartition-lignes {
        gap: 6px;
    }
}
</style>
</head>

<body>

<div class="conteneur">

    <h1>Floods</h1>

    <div class="tableau" id="tableauFloods">

        <div class="entete">
            <div>TDC gagné</div>
            <div>Date</div>
            <div>Heure</div>
            <div></div>
        </div>

    </div>

    <button class="plus" id="boutonPlus" onclick="ajouterLigne()">+</button>

    <div class="options">

        <div class="bloc-calcul">

            <div class="champ-pourcentage">

                <label class="label" for="pourcentage">
                    Pourcentage à donner
                </label>

                <input
                    class="pourcentage"
                    id="pourcentage"
                    type="number"
                    min="0"
                    max="100"
                    step="0.01"
                    value="0"
                >

            </div>

            <button class="bouton" onclick="calculer()">
                Calculer
            </button>

        </div>


        <div class="choix-calcul">

            <label>

                <input
                    type="checkbox"
                    id="choisirCalcul"
                    onchange="afficherDateCalcul()"
                >

                Choisir l'heure du calcul

            </label>

        </div>


        <div id="champDateCalcul">

            <label class="label" for="dateCalcul">
                Date et heure du calcul
            </label>

            <input
                id="dateCalcul"
                type="datetime-local"
                step="60"
            >

        </div>


        <div class="repartition">

            <div class="repartition-titre">
                Répartition des RSS
            </div>


            <div class="repartition-lignes">

                <div class="repartition-case">

                    <label class="label" for="nourriture">
                        Nourriture (%)
                    </label>

                    <input
                        id="nourriture"
                        type="number"
                        min="0"
                        max="100"
                        step="1"
                        value="0"
                        oninput="mettreAJourSomme()"
                    >

                </div>


                <div class="repartition-case">

                    <label class="label" for="bois">
                        Bois (%)
                    </label>

                    <input
                        id="bois"
                        type="number"
                        min="0"
                        max="100"
                        step="1"
                        value="0"
                        oninput="mettreAJourSomme()"
                    >

                </div>


                <div class="repartition-case">

                    <label class="label" for="eau">
                        Eau (%)
                    </label>

                    <input
                        id="eau"
                        type="number"
                        min="0"
                        max="100"
                        step="1"
                        value="0"
                        oninput="mettreAJourSomme()"
                    >

                </div>

            </div>


            <div class="somme" id="sommeRepartition">
                Total : 0 %
            </div>

        </div>

    </div>


    <div id="resultat"></div>

    <div class="message" id="message"></div>

</div>


<script>

const MAX_LIGNES = 15;

let nombreLignes = 0;


/* =========================================================
   AJOUT D'UNE LIGNE
   ========================================================= */

function ajouterLigne() {

    if (nombreLignes >= MAX_LIGNES) {
        return;
    }

    nombreLignes++;

    const tableau =
        document.getElementById("tableauFloods");

    const ligne =
        document.createElement("div");

    ligne.className = "ligne";


    /* TDC */

    const tdc =
        document.createElement("div");

    const inputTdc =
        document.createElement("input");

    inputTdc.type = "number";
    inputTdc.min = "0";
    inputTdc.step = "0.01";
    inputTdc.placeholder = "TDC";
    inputTdc.className = "tdc";

    tdc.appendChild(inputTdc);


    /* DATE */

    const date =
        document.createElement("div");

    const inputDate =
        document.createElement("input");

    inputDate.type = "date";
    inputDate.className = "date";

    date.appendChild(inputDate);


    /* HEURE */

    const heure =
        document.createElement("div");

    const inputHeure =
        document.createElement("input");

    inputHeure.type = "time";
    inputHeure.className = "heure";

    /*
       Pas de secondes :
       l'heure est uniquement saisie sous la forme HH:MM.
    */

    inputHeure.step = "60";

    heure.appendChild(inputHeure);


    /* SUPPRESSION */

    const action =
        document.createElement("div");

    const supprimer =
        document.createElement("button");

    supprimer.className = "supprimer";

    supprimer.textContent = "×";

    supprimer.title = "Supprimer ce flood";


    supprimer.onclick = function() {

        ligne.remove();

        nombreLignes--;

        mettreAJourBoutonPlus();

    };


    action.appendChild(supprimer);


    ligne.appendChild(tdc);
    ligne.appendChild(date);
    ligne.appendChild(heure);
    ligne.appendChild(action);

    tableau.appendChild(ligne);

    mettreAJourBoutonPlus();
}


/* =========================================================
   BOUTON +
   ========================================================= */

function mettreAJourBoutonPlus() {

    const bouton =
        document.getElementById("boutonPlus");

    bouton.disabled =
        nombreLignes >= MAX_LIGNES;

    bouton.style.opacity =
        bouton.disabled ? "0.5" : "1";

    bouton.style.cursor =
        bouton.disabled ? "default" : "pointer";
}


/* =========================================================
   CHOIX DE L'HEURE DU CALCUL
   ========================================================= */

function afficherDateCalcul() {

    const coche =
        document.getElementById("choisirCalcul").checked;

    const champ =
        document.getElementById("champDateCalcul");


    champ.style.display =
        coche ? "block" : "none";


    /*
       Quand la case est cochée, on propose directement
       l'heure actuelle arrondie à l'heure pile.
    */

    if (
        coche &&
        !document.getElementById("dateCalcul").value
    ) {

        const maintenant =
            new Date();

        const heurePile =
            new Date(maintenant);

        heurePile.setMinutes(0, 0, 0);

        document.getElementById("dateCalcul").value =
            formatDateInput(heurePile);
    }
}


/* =========================================================
   FORMAT DATE POUR LE CHAMP HTML
   ========================================================= */

function formatDateInput(date) {

    const annee =
        date.getFullYear();

    const mois =
        String(date.getMonth() + 1).padStart(2, "0");

    const jour =
        String(date.getDate()).padStart(2, "0");

    const heure =
        String(date.getHours()).padStart(2, "0");

    const minutes =
        String(date.getMinutes()).padStart(2, "0");


    return (
        annee +
        "-" +
        mois +
        "-" +
        jour +
        "T" +
        heure +
        ":" +
        minutes
    );
}


/* =========================================================
   SOMME DE LA RÉPARTITION
   ========================================================= */

function mettreAJourSomme() {

    const nourriture =
        Number(
            document.getElementById("nourriture").value
        ) || 0;

    const bois =
        Number(
            document.getElementById("bois").value
        ) || 0;

    const eau =
        Number(
            document.getElementById("eau").value
        ) || 0;


    const somme =
        nourriture +
        bois +
        eau;


    document.getElementById(
        "sommeRepartition"
    ).textContent =
        "Total : " +
        formatNombre(somme) +
        " %";
}


/* =========================================================
   ARRONDIR L'HEURE DU FLOOD À L'HEURE SUIVANTE
   ========================================================= */

/*
   Exemple :

   14h00 → 15h00
   14h20 → 15h00
   14h59 → 15h00

   Comme les minutes sont obligatoires, même un flood
   à 14h00 commence à produire à 15h00.
*/

function arrondirHeureSuivante(date) {

    const resultat =
        new Date(date);

    resultat.setMinutes(0, 0, 0);

    resultat.setHours(
        resultat.getHours() + 1
    );

    return resultat;
}


/* =========================================================
   ARRONDIR L'HEURE DU CALCUL À L'HEURE PRÉCÉDENTE
   ========================================================= */

/*
   Exemple :

   14h20 → 14h00
   14h59 → 14h00
   14h00 → 14h00
*/

function arrondirHeurePrecedente(date) {

    const resultat =
        new Date(date);

    resultat.setMinutes(0, 0, 0);

    resultat.setSeconds(0, 0);

    resultat.setMilliseconds(0);

    return resultat;
}


/* =========================================================
   CALCUL PRINCIPAL
   ========================================================= */

function calculer() {

    const lignes =
        document.querySelectorAll(".ligne");

    const maintenant =
        new Date();


    const pourcentage =
        Number(
            document.getElementById("pourcentage").value
        );


    const resultat =
        document.getElementById("resultat");

    const message =
        document.getElementById("message");


    resultat.innerHTML = "";

    message.textContent = "";


    /* POURCENTAGE À DONNER */

    if (
        !Number.isFinite(pourcentage) ||
        pourcentage < 0 ||
        pourcentage > 100
    ) {

        message.textContent =
            "Le pourcentage à donner doit être compris entre 0 et 100 %.";

        return;
    }


    /* RÉPARTITION */

    const nourriture =
        Number(
            document.getElementById("nourriture").value
        ) || 0;

    const bois =
        Number(
            document.getElementById("bois").value
        ) || 0;

    const eau =
        Number(
            document.getElementById("eau").value
        ) || 0;


    const somme =
        nourriture +
        bois +
        eau;


    if (
        Math.abs(somme - 100) > 0.000001
    ) {

        message.textContent =
            "La répartition nourriture + bois + eau doit être égale à 100 %.";

        return;
    }


    /* =====================================================
       DÉTERMINATION DE L'HEURE DU CALCUL
       ===================================================== */

    let dateCalcul;


    if (
        document.getElementById("choisirCalcul").checked
    ) {

        const valeur =
            document.getElementById("dateCalcul").value;


        if (!valeur) {

            message.textContent =
                "Renseigne la date et l'heure du calcul.";

            return;
        }


        dateCalcul =
            new Date(valeur);


        if (
            isNaN(dateCalcul.getTime())
        ) {

            message.textContent =
                "La date et l'heure du calcul sont invalides.";

            return;
        }

    } else {

        dateCalcul =
            maintenant;
    }


    /*
       Dans tous les cas, l'heure du calcul est arrondie
       à l'heure pile précédente.
    */

    dateCalcul =
        arrondirHeurePrecedente(dateCalcul);


    /* =====================================================
       CALCUL DES RSS
       ===================================================== */

    let totalRss = 0;

    let floodsValides = 0;


    lignes.forEach(ligne => {

        const tdc =
            Number(
                ligne.querySelector(".tdc").value
            );

        const date =
            ligne.querySelector(".date").value;

        const heure =
            ligne.querySelector(".heure").value;


        /*
           Une ligne incomplète est ignorée.
        */

        if (
            !tdc ||
            tdc <= 0 ||
            !date ||
            !heure
        ) {
            return;
        }


        const debutOriginal =
            new Date(
                date +
                "T" +
                heure
            );


        if (
            isNaN(debutOriginal.getTime())
        ) {
            return;
        }


        /*
           Le début du flood est arrondi à l'heure suivante.

           Exemple :
           Flood à 14h20
           → production à partir de 15h00.
        */

        const debut =
            arrondirHeureSuivante(
                debutOriginal
            );


        /*
           Si le flood commence après ou exactement
           à l'heure du calcul, il n'a encore rien produit.
        */

        if (
            debut >= dateCalcul
        ) {
            return;
        }


        /*
           Nombre d'heures complètes entre le début
           de production et l'heure du calcul.
        */

        const heuresEcoulees =
            (
                dateCalcul -
                debut
            ) / 3600000;


        if (
            heuresEcoulees > 0
        ) {

            /*
               1 TDC = 1 RSS par heure.
            */

            totalRss +=
                tdc *
                heuresEcoulees;

            floodsValides++;
        }

    });


    /* AUCUN FLOOD VALIDE */

    if (
        floodsValides === 0
    ) {

        message.textContent =
            "Aucun flood ne produit de RSS entre son heure de départ et l'heure du calcul.";

        return;
    }


    /* =====================================================
       RSS À DONNER
       ===================================================== */

    /*
       Le résultat est arrondi à l'entier le plus proche.
    */

    const aDonner =
        Math.round(
            totalRss *
            pourcentage /
            100
        );


    /* =====================================================
       RÉPARTITION
       ===================================================== */

    const rssNourriture =
        Math.round(
            aDonner *
            nourriture /
            100
        );


    const rssBois =
        Math.round(
            aDonner *
            bois /
            100
        );


    const rssEau =
        Math.round(
            aDonner *
            eau /
            100
        );


    /* =====================================================
       AFFICHAGE
       ===================================================== */

    resultat.innerHTML =

        "RSS produits : " +
        formatNombre(
            Math.floor(totalRss)
        ) +

        "<br>À donner (" +
        formatNombre(pourcentage) +
        " %) : " +
        formatNombre(aDonner) +

        "<br><br>" +

        "Nourriture : " +
        formatNombre(rssNourriture) +

        "<br>" +

        "Bois : " +
        formatNombre(rssBois) +

        "<br>" +

        "Eau : " +
        formatNombre(rssEau);


    /* =====================================================
       AFFICHAGE DE L'HEURE DU CALCUL
       ===================================================== */

    const dateAffichee =
        dateCalcul.toLocaleString(
            "fr-FR",
            {
                dateStyle: "short",
                timeStyle: "short"
            }
        );


    message.textContent =
        "Calcul effectué pour le " +
        dateAffichee +
        ".";
}


/* =========================================================
   FORMATAGE DES NOMBRES
   ========================================================= */

function formatNombre(nombre) {

    return Math.round(
        nombre
    ).toLocaleString(
        "fr-FR"
    );
}


/* =========================================================
   INITIALISATION
   ========================================================= */

// Une seule ligne au démarrage.
ajouterLigne();

mettreAJourSomme();

</script>

</body>
</html>
